# Content-Security-Policy: only this site's own files may load. The build fills in the
# script-src placeholder with the fingerprints of the small inline script in <head>
# (scripts/prerender.mjs). Styles allow inline because a few elements carry a style attribute.
/*
  X-Robots-Tag: noindex, nofollow, noarchive
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' INLINE_SCRIPT_HASHES; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self'; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Fonts never change under the same name.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Video, sound and pictures keep their names when replaced, so cache for a day and refresh quietly
# in the background for a week after that.
/media/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
